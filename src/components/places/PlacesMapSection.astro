---
import HeadingUnderline from "../HeadingUnderline.astro";
import {
  PLACES_PAGE,
  REGION_GROUPS,
  countByPrefecture,
  countOnline,
  toMapPoints,
} from "../../data/places";
import type { Location } from "../../lib/microcms";
import bubbleImg from "../../assets/bubbles/bubble-2.png";
import bubbleWide from "../../assets/bubbles/bubble-wide.png";

interface Props {
  locations: Location[];
}

const { locations } = Astro.props;
const prefCounts = countByPrefecture(locations);
const onlineCount = countOnline(locations);
const regionsWithData = REGION_GROUPS.filter((region) =>
  region.prefectures.some((p) => (prefCounts.get(p) ?? 0) > 0),
);
const mapPoints = toMapPoints(locations);
---

<section
  id="map-search"
  class="bg-white rounded-2xl md:rounded-3xl px-6 py-8 md:px-10 md:py-10"
>
  <HeadingUnderline class="mb-3 md:mb-4">{PLACES_PAGE.mapTitle}</HeadingUnderline>
  <p class="mx-auto mb-6 max-w-2xl text-center font-normal leading-relaxed text-black/75">
    {PLACES_PAGE.mapLead}
  </p>

  <div
    class="relative mx-auto mb-4 max-w-3xl overflow-hidden rounded-[1.75rem] border border-[var(--color-primary)]/15 bg-[var(--color-background)]"
  >
    <div
      id="places-leaflet-map"
      class="places-leaflet-map h-[min(70vh,28rem)] w-full md:h-[min(72vh,34rem)]"
      data-points={JSON.stringify(mapPoints)}
      role="region"
      aria-label="「福祉」の位置を示す地図"
    >
    </div>
    {
      mapPoints.length === 0 && (
        <p class="absolute inset-0 z-[500] flex items-center justify-center bg-[var(--color-background)]/90 px-6 text-center text-small text-black/60">
          地図に表示できる位置情報がまだありません
        </p>
      )
    }
  </div>

  {
    onlineCount > 0 && (
      <div class="mx-auto mb-8 flex max-w-3xl flex-col items-center gap-2">
        <p class="text-small tracking-wide text-black/55">
          {PLACES_PAGE.onlineLead}
        </p>
        <button
          type="button"
          class="place-online-btn group relative inline-flex min-w-[9rem] items-center justify-center px-2 py-1"
          data-filter-type="tag"
          data-filter-value={PLACES_PAGE.onlineTag}
          aria-pressed="false"
        >
          <img
            src={bubbleWide.src}
            alt=""
            aria-hidden="true"
            class="h-12 w-auto opacity-90 transition-transform group-hover:scale-105 group-aria-[pressed=true]:scale-110 sm:h-14"
          />
          <span class="absolute inset-0 flex flex-col items-center justify-center leading-tight">
            <span class="text-small font-bold">{PLACES_PAGE.onlineLabel}</span>
            <span class="text-[0.65rem] font-normal text-[var(--color-primary)]">
              {onlineCount}
            </span>
          </span>
        </button>
      </div>
    )
  }

  <div class="space-y-6">
    {
      regionsWithData.map((region) => (
        <div>
          <p class="mb-2 text-small tracking-wide text-black/55">{region.name}</p>
          <div class="flex flex-wrap gap-2">
            {region.prefectures.map((pref) => {
              const count = prefCounts.get(pref) ?? 0;
              if (count === 0) {
                return (
                  <span
                    class="inline-flex min-w-[4.25rem] items-center justify-center rounded-full border border-black/10 px-3 py-2 text-small font-normal text-black/30"
                    title="まだ掲載がありません"
                  >
                    {pref.replace(/[都道府県]$/, "")}
                  </span>
                );
              }
              return (
                <button
                  type="button"
                  class="place-pref-btn group relative inline-flex min-w-[4.5rem] items-center justify-center px-1 py-1"
                  data-prefecture={pref}
                  aria-pressed="false"
                >
                  <img
                    src={bubbleImg.src}
                    alt=""
                    aria-hidden="true"
                    class="h-12 w-auto opacity-90 transition-transform group-hover:scale-105 group-aria-[pressed=true]:scale-110"
                  />
                  <span class="absolute inset-0 flex flex-col items-center justify-center leading-tight">
                    <span class="text-small font-bold">
                      {pref.replace(/[都道府県]$/, "")}
                    </span>
                    <span class="text-[0.65rem] font-normal text-[var(--color-primary)]">
                      {count}
                    </span>
                  </span>
                </button>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style is:global>
  .places-leaflet-map .leaflet-container {
    font: inherit;
    background: #fffbec;
  }

  .places-leaflet-map .leaflet-control-attribution {
    font-size: 0.65rem;
    background: rgb(255 255 255 / 0.85);
  }

  .places-map-pin {
    background: transparent;
    border: none;
  }

  .places-map-pin__dot {
    display: block;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 999px;
    background: var(--color-primary);
    border: 2px solid white;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.25);
  }

  .places-map-pin.is-active .places-map-pin__dot {
    width: 1.35rem;
    height: 1.35rem;
    background: #4f7350;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  .places-map-popup .leaflet-popup-content-wrapper {
    border-radius: 0.85rem;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.12);
  }

  .places-map-popup .leaflet-popup-content {
    margin: 0.65rem 0.85rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .places-map-popup__btn {
    display: inline-block;
    margin-top: 0.35rem;
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
  }
</style>
