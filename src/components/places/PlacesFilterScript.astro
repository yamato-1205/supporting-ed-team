---
/**
 * 絞り込みクライアントのエントリ。ロジックは src/lib/places/filter-client.ts。
 */
import { PLACES_PAGE } from "../../data/places";
---

<div
  id="places-filter-root"
  hidden
  data-open-label={PLACES_PAGE.openMap}
  data-close-label={PLACES_PAGE.closeMap}
>
</div>

<script>
  import { initPlacesFilter } from "../../lib/places/filter-client";

  const root = document.getElementById("places-filter-root");
  initPlacesFilter({
    openMapLabel: root?.dataset.openLabel ?? "詳細",
    closeMapLabel: root?.dataset.closeLabel ?? "閉じる",
  });
</script>
