---
import Layout from "../layouts/Layout.astro";
import MultilineText from "../components/MultilineText.astro";
import PageTitle from "../components/PageTitle.astro";
import PlacesMapSection from "../components/places/PlacesMapSection.astro";
import PlacesResults from "../components/places/PlacesResults.astro";
import PlacesFilterScript from "../components/places/PlacesFilterScript.astro";
import { client } from "../lib/microcms";
import type { Location } from "../lib/microcms";
import { PLACES_PAGE, countByPrefecture } from "../data/places";
import bubbleWide from "../assets/bubbles/bubble-wide.png";
import bubbleSoft from "../assets/bubbles/bubble-3.png";
import { PAGE_META } from "../data/site";

let locations: Location[] = [];
try {
  const res = await client.getList<Location>({
    endpoint: "location",
    queries: { limit: 100 },
  });
  locations = res.contents;
} catch (e) {
  console.warn("[places] 居場所一覧の取得に失敗しました:", e);
}

const prefCount = countByPrefecture(locations).size;
const meta = PAGE_META.places;
---

<Layout noindex title={meta.title} description={meta.description}>
  <div
    id="places"
    class="relative z-10 pt-[calc(var(--header-height)+2rem)] pb-12 md:pt-[calc(var(--header-height)+2.5rem)] md:pb-16"
  >
    <div class="section-container flex flex-col gap-8 md:gap-10">
      <PageTitle title={PLACES_PAGE.title} />

      <section
        class="relative overflow-hidden rounded-2xl bg-white px-6 py-8 md:rounded-3xl md:px-10 md:py-10"
      >
        <img
          src={bubbleSoft.src}
          alt=""
          aria-hidden="true"
          class="places-intro-bubble pointer-events-none absolute -left-4 top-2 h-16 w-auto opacity-45 md:h-20"
        />
        <img
          src={bubbleSoft.src}
          alt=""
          aria-hidden="true"
          class="places-intro-bubble places-intro-bubble--delay pointer-events-none absolute -right-3 bottom-3 h-14 w-auto opacity-40 md:h-16"
        />
        <div class="relative mx-auto max-w-2xl text-center">
          <p class="places-lead relative inline-block px-2">
            <span class="relative z-10 font-bold tracking-wide text-[var(--color-primary)] md:text-lg">
              {PLACES_PAGE.lead}
            </span>
            <span class="places-lead-mark" aria-hidden="true"></span>
          </p>
          <MultilineText
            text={PLACES_PAGE.intro}
            class="mt-5 font-normal leading-relaxed text-black/75"
          />
        </div>
      </section>

      <div class="grid grid-cols-2 gap-3 sm:mx-auto sm:max-w-md">
        <div
          class="relative flex flex-col items-center justify-center px-2 py-4 text-center"
        >
          <img
            src={bubbleWide.src}
            alt=""
            aria-hidden="true"
            class="absolute inset-0 m-auto h-20 w-auto opacity-90 sm:h-24"
          />
          <p class="relative text-2xl font-bold text-[var(--color-primary)] sm:text-3xl">
            {prefCount}
          </p>
          <p class="relative text-small font-normal">{PLACES_PAGE.statsPrefLabel}</p>
        </div>
        <div
          class="relative flex flex-col items-center justify-center px-2 py-4 text-center"
        >
          <img
            src={bubbleWide.src}
            alt=""
            aria-hidden="true"
            class="absolute inset-0 m-auto h-20 w-auto opacity-90 sm:h-24"
          />
          <p class="relative text-2xl font-bold text-[var(--color-primary)] sm:text-3xl">
            {locations.length}
          </p>
          <p class="relative text-small font-normal">{PLACES_PAGE.statsCountLabel}</p>
        </div>
      </div>

      <PlacesMapSection locations={locations} />
      <PlacesResults locations={locations} />
    </div>
  </div>
  <PlacesFilterScript />
</Layout>

<style>
  .places-lead-mark {
    position: absolute;
    left: 50%;
    bottom: 0.05em;
    z-index: 0;
    width: calc(100% + 0.4em);
    height: 0.5em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 22%, white);
    transform: translateX(-50%) rotate(-1.4deg);
  }

  .places-intro-bubble {
    animation: places-bubble-float 5.2s ease-in-out infinite;
  }

  .places-intro-bubble--delay {
    animation-delay: -2.4s;
    animation-duration: 6s;
  }

  @keyframes places-bubble-float {
    0%,
    100% {
      transform: translateY(0) rotate(-4deg);
    }
    50% {
      transform: translateY(-7px) rotate(3deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .places-intro-bubble {
      animation: none;
    }
  }
</style>
